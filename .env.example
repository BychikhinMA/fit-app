# Скопируй этот файл в .env и заполни значениями из Supabase (Project Settings -> API).
# .env уже в .gitignore — эти ключи никогда не попадут в git.

# Project URL (Settings -> API -> Project URL)
EXPO_PUBLIC_SUPABASE_URL=

# anon public key (Settings -> API -> Project API keys -> anon public)
# Этот ключ ок класть в приложение — он публичный и ограничен правилами доступа (RLS) в базе.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Ниже НЕ для приложения, только для Supabase Edge Function (сервер) ---
# service_role key (Settings -> API -> Project API keys -> service_role) — секретный, полные права
SUPABASE_SERVICE_ROLE_KEY=

# Ключ Claude API (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Ключ NVIDIA NIM API (build.nvidia.com -> аккаунт -> Get API Key), для Шага 3.
# Тоже секрет функции, НЕ приложения — этот файл только документирует, где взять,
# реальное значение задаётся в Supabase Dashboard -> Edge Functions -> Manage secrets.
NVIDIA_API_KEY=
